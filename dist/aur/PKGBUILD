# Maintainer: minhmc2077 quangminh21072010@gmail.com

pkgname=anicode-git
pkgver=1.0.0
pkgrel=1
pkgdesc="An AI coding agent with anime aesthetic, persistent cross-repo memory engine, and integrated YouTube Music control. Fork of opencode."
arch=('x86_64' 'aarch64')
url="https://github.com/minhmc2007/AniCode"
license=('MIT')
depends=(
  'nodejs>=18'
  'mpv'
  'yt-dlp'
  'python'
  'python-pip'
)
makedepends=(
  'git'
  'bun'
)
optdepends=(
  'chafa: terminal image rendering support'
  'kitty-terminal: enhanced terminal graphics protocol support'
)
provides=('anicode')
conflicts=('anicode' 'opencode')
source=("git+${url}.git#branch=dev?depth=1")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  local describe=$(git describe --long --tags --always 2>/dev/null || echo "1.0.0")
  # Strip leading 'v', replace hyphens with dots, remove g prefix
  echo "$describe" | sed 's/^v//' | sed 's/-/./g' | sed 's/g/./'
}

build() {
  cd "$srcdir/AniCode"
  
  # Install all dependencies
  bun install --frozen-lockfile
  
  # Build all packages
  bun run build
  
  # Build single binary
  cd packages/opencode
  bun run build -- --single
  cd ../..
}

check() {
  cd "$srcdir/AniCode"
  bun typecheck 2>/dev/null || echo "Skipping typecheck for AUR build"
}

package() {
  cd "$srcdir/AniCode"
  
  # Install main binary
  install -Dm755 packages/opencode/dist/anicode-linux-x64/bin/anicode "$pkgdir/usr/bin/anicode"
  
  ln -sf anicode "$pkgdir/usr/bin/ani"
  
  # Install license
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  
  # Create default config directory structure
  install -dm755 "$pkgdir/etc/anicode"
  cat > "$pkgdir/etc/anicode/anicode.json" << 'EOF'
{
  "personality": "You are AniCode, an AI coding agent with an anime aesthetic. Be helpful, creative, and precise in your responses.",
  "theme": "anicli",
  "backgroundImage": "/usr/share/anicode/default-bg.png"
}
EOF
}

# post_install message
post_install() {
  echo ":: AniCode has been installed!"
  echo ":: Run 'anicode' to start the CLI"
  echo ":: Run 'ani' as a shorthand"
  echo ""
  echo ":: Configuration: ~/.config/anicode/anicode.json"
  echo ":: Data storage:  ~/.local/share/anicode/"
  echo ":: Memory file:   .anicode/memory.md (per project)"
  echo ""
  echo ":: For YouTube Music integration, ensure mpv is installed"
  echo ":: For background image support, install chafa or use Kitty terminal"
  echo ":: Thanks you for using my project"
}
